[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
default-time-zone    = '+09:00'

# -----------------------------------------------------------------------------
# トランザクション分離レベル
# InnoDB のデフォルトも REPEATABLE-READ だが、排他制御の挙動は分離レベルに
# 強く依存するため、検証の前提として明示しておく。
#   - 楽観的ロック: UPDATE ... WHERE version = ? の件数で競合を検知
#   - 悲観的ロック: SELECT ... FOR UPDATE は分離レベルに関わらず「最新のコミット済み行」
#                   を読み、行ロックを取得する（ロッキングリード）
# -----------------------------------------------------------------------------
transaction-isolation = REPEATABLE-READ

# -----------------------------------------------------------------------------
# ロック待ちタイムアウト（秒）
# デフォルトは 50 秒。SELECT FOR UPDATE の検証時に「待たされる」挙動を
# 観察しつつ、長すぎて検証が進まないことを避けるため 10 秒にしている。
# -----------------------------------------------------------------------------
innodb_lock_wait_timeout = 10

# -----------------------------------------------------------------------------
# General Query Log
# 実際に発行された SQL をすべて記録する。本番では絶対に有効にしないが、
# 「どのタイミングでどの SQL が発行されたか」を確認するのがこの検証の肝なので有効にする。
# 確認方法: docker compose exec db tail -f /var/lib/mysql/general.log
# 読み方:
#   - 2列目の数字は「接続ID」。ブラウザA/Bのリクエストは別接続になるので、
#     この番号でどちらのリクエストが発行した SQL かを区別できる。
#   - Laravel(PDO) はプリペアドステートメントを使うため、SQL は
#     Prepare / Execute の2行で出る。Execute 行にはバインド値が埋め込まれた SQL が出る。
# -----------------------------------------------------------------------------
general_log      = 1
general_log_file = /var/lib/mysql/general.log
# ログの時刻を UTC ではなくサーバーのタイムゾーン(JST)で出し、画面操作の時刻と突き合わせやすくする
log_timestamps   = SYSTEM
